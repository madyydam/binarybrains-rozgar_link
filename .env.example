# Environment configuration for RozgarLink
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rozgarlink
REDIS_URL=redis://localhost:6379
JWT_SECRET=super-secret-jwt-key-for-rozgarlink-dev-environment-12345
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-for-rozgarlink-dev-environment-67890
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-3-haiku-20240307
EMBEDDING_MODEL=text-embedding-3-small
AI_ENABLED=true
AI_PHRASE_DAILY_BUDGET=5000
RANK_WEIGHTS_VERSION=v1
RELATION_THRESHOLDS=0.70,0.85
OTP_PROVIDER=console
DEFAULT_LOCALE=en
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
NEXT_PUBLIC_EVENTS_URL=http://localhost:4000/v1/events
